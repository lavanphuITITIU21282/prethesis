# Copy to .env.local on the server. Never place this key in public/ or browser storage.
GEMINI_API_KEY=replace_with_your_Google_AI_Studio_key
GEMINI_MODEL=gemini-3.5-flash

# Optional server-only PostgreSQL URL. Leave blank to use local runtime credentials.
# Local setup: db:migrate, db:seed, then db:provision. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=

# Pin the public origin behind a reverse proxy, e.g. https://study.example.
# HTTPS requires Secure cookies. HTTP is only for a trusted local development/LAN setup.
AUTH_ORIGIN=
AUTH_COOKIE_SECURE=false

# Optional Google OAuth Web application. Use an exact HTTPS or loopback origin.
# Register <GOOGLE_OAUTH_ORIGIN>/api/auth/google/callback as the authorized redirect URI.
# If GOOGLE_OAUTH_ORIGIN is blank, Google sign-in uses AUTH_ORIGIN.
GOOGLE_OAUTH_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
