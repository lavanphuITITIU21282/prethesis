{
  "name": "tram-hoc-security",
  "version": "2.0.0",
  "private": true,
  "description": "Trạm học an toàn thông tin bằng tiếng Việt, chạy offline trong LAN",
  "type": "module",
  "scripts": {
    "dev": "node scripts/runtime/run-next.mjs dev",
    "build": "node scripts/runtime/task.mjs build",
    "start": "node scripts/runtime/run-next.mjs start",
    "typecheck": "node scripts/runtime/task.mjs typecheck",
    "lint": "node scripts/runtime/task.mjs lint",
    "lint:fix": "node scripts/runtime/task.mjs lint:fix",
    "test": "node scripts/runtime/task.mjs test",
    "format": "node scripts/runtime/task.mjs format",
    "format:check": "node scripts/runtime/task.mjs format:check",
    "db:setup": "node scripts/runtime/task.mjs db:setup",
    "db:start": "node scripts/runtime/task.mjs db:start",
    "db:stop": "node scripts/runtime/task.mjs db:stop",
    "db:status": "node scripts/runtime/task.mjs db:status",
    "db:check": "node scripts/runtime/task.mjs db:check",
    "db:shell": "node scripts/runtime/task.mjs db:shell",
    "db:migrate": "node scripts/runtime/task.mjs db:migrate",
    "db:seed": "node scripts/runtime/task.mjs db:seed",
    "db:provision": "node scripts/runtime/task.mjs db:provision",
    "test:db": "node scripts/runtime/task.mjs test:db",
    "db:backup": "node scripts/runtime/task.mjs db:backup",
    "db:verify-backup": "node scripts/runtime/task.mjs db:verify-backup",
    "check": "node scripts/checks/validate-content.mjs",
    "check:architecture": "node scripts/checks/check-architecture.mjs",
