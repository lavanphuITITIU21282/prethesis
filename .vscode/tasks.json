    {
      "label": "Trạm học: Chạy website",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/RUN-VSCODE.ps1"
