{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trạm học: Khởi tạo database đầy đủ",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Trạm học: Chuẩn bị PostgreSQL",
        "Trạm học: Áp dụng migration",
        "Trạm học: Seed nội dung",
        "Trạm học: Tạo role runtime"
      ],
      "problemMatcher": []
    },
    {
      "label": "Trạm học: Áp dụng migration",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/windows/Run-Task.ps1",
        "-Task",
        "db:migrate"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Trạm học: Seed nội dung",
